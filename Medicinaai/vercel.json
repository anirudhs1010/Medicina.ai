{
    "builds": [
        {
            "src": "/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "(.)",
            "dest": "/main.py"
        },
        {
            "src": "/(.)",
            "headers": {"Access-Control-Allow-Origin": "*"},
            "continue": true
        }
    ]
}